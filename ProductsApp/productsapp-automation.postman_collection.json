              "//Test 1-4: Check all 4 variables for Hammer\r",
              "pm.test(\"Check that Id is 3\", () => { pm.expect(jsonData.Id).to.equal(3); });\r",
              "pm.test(\"Check that Name is Humvee\", () => { pm.expect(jsonData.Name).to.equal(\"Humvee\"); });\r",
              "pm.test(\"Check that Category is Car\", () => { pm.expect(jsonData.Category).to.equal(\"Car\"); });\r",
              "pm.test(\"Check that Price is 86.86\", () => { pm.expect(jsonData.Price).to.equal(86.86); });\r",
              "\r",
              "//Test 5: Check and Verify HTTP status code\r",
              "pm.test(\"Status code is 200\", () => {pm.response.to.have.status(200)});\r",
